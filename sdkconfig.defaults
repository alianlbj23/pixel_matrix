CONFIG_IDF_TARGET="esp32s3"

# HUB75 library: build without Adafruit GFX / Arduino (pure ESP-IDF, NO_GFX).
CONFIG_ESP32_HUB75_USE_GFX=n

# Console on USB Serial/JTAG only: GPIO43 (UART0 TX) is used as I2S BCLK for audio.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# 16 MB of the 32 MB flash + custom partitions (3 MB "gif" PXG1, 10 MB "audio" PXA1).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_APP_REPRODUCIBLE_BUILD=y
